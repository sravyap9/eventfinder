# Copy to app/.env.local (ignored by git), fill in, then run `npm run build` and commit ../v2.
# Both values are on Supabase: Project Settings, API. The anon key is public by design (the database only lets it insert).
# NEVER put the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
